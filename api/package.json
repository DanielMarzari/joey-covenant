{
  "name": "csb-admin-api",
  "version": "0.1.0",
  "private": true,
  "description": "Covenant Senior Benefits — admin API + UI (Cloudflare Worker + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute csb --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute csb --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute csb --local --file=./seed.sql",
    "hash": "node scripts/hash-password.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
